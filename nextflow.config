// nextflow.config
//
// NOTE: The primary orchestrator is run_pipeline.sh + pipeline.conf.
// This Nextflow config is kept for future HPC/cloud migration.
// Current status: FQ2BAM + Mutect2 skeleton only (main.nf).
// DeepSomatic, Open CRAVAT, and PCGR processes to be added when migrating.

params {
    // Image versions — keep in sync with pipeline.conf
    parabricks_image = 'nvcr.io/nvidia/clara/clara-parabricks:4.7.0-1'
    pcgr_image       = 'sigven/pcgr:2.2.5'
    gatk_image       = 'broadinstitute/gatk:4.5.0.0'

    // References
    ref_dir          = '/mnt/storage/parabricks_test/ref'

    // Pipeline defaults
    num_gpus         = 1
    tumor_type       = 'LUAD'
    model_type       = 'WGS'
    pcgr_assay       = 'WGS'
    tumor_purity     = 0.6
    workers          = 5
    outdir           = 'results'
}

profiles {
    gpu_local {
        docker.enabled    = true
        // Restrict to GPU 0 — GPU 1 reserved for VLLM on this machine
        docker.runOptions = '--gpus "device=0"'
        process.executor  = 'local'
    }

    aws_batch {
        process.executor     = 'awsbatch'
        process.queue        = 'gpu-queue'
        aws.region           = 'us-east-1'
        aws.batch.cliPath    = '/usr/local/bin/aws'
        // Use p4d.24xlarge (A100) or g5.24xlarge (A10G) for Parabricks
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--gres=gpu:1'
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/trace.tsv"
}

manifest {
    name            = 'precision-oncology-pipeline'
    description     = 'GPU-accelerated precision oncology: FQ2BAM → DeepSomatic → OpenCRAVAT → PCGR'
    version         = '2.0.0'
    nextflowVersion = '>=23.10.0'
}
